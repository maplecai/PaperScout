# .env.example —— 复制成 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）
# GitHub Actions 上不需要 .env，改为在仓库 Settings → Secrets 里配同名 secret

# --- LLM（必需）---
# 百度千帆 OpenAI 协议兼容 endpoint
OPENAI_BASE_URL=https://qianfan.baidubce.com/v2/tokenplan/personal
OPENAI_API_KEY=bce-v3/xxxxx
OPENAI_MODEL=glm-5.2

# --- PubMed 提速（可选）---
# https://www.ncbi.nlm.nih.gov/account/settings/ 免费申请，限速 3→10 req/s
NCBI_API_KEY=

# --- 微信推送 Server酱（可选）---
# https://sct.ftqq.com/ 微信扫码登录后获取
SC_SENDKEY=

# --- Email 推送（可选）---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
